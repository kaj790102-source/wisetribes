# ─── Claude AI ───────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Instagram / Meta Graph API ──────────────────────────────
# Step-by-step to get these:
#
# 1. Go to https://developers.facebook.com/ and create an App
#    (choose "Business" type)
#
# 2. Add "Instagram Graph API" product to your app
#
# 3. Connect your Instagram Professional account (Business or Creator)
#    via Facebook Page → Settings → Instagram
#
# 4. In the Graph API Explorer (https://developers.facebook.com/tools/explorer):
#    - Select your app
#    - Generate a User Access Token with these permissions:
#        instagram_basic
#        instagram_content_publish
#        pages_show_list
#        pages_read_engagement
#
# 5. Exchange for a Long-Lived Token (lasts 60 days):
#    GET https://graph.facebook.com/v18.0/oauth/access_token
#      ?grant_type=fb_exchange_token
#      &client_id={app-id}
#      &client_secret={app-secret}
#      &fb_exchange_token={short-lived-token}
#
# 6. Get your Instagram Business Account ID:
#    GET https://graph.facebook.com/v18.0/me/accounts?access_token={token}
#    Then: GET https://graph.facebook.com/v18.0/{page-id}?fields=instagram_business_account&access_token={token}

INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# ─── Airtable (Lead Collection) ───────────────────────────────────────────────
# Get your Personal Access Token at: https://airtable.com/create/tokens
# Base ID is in your base URL: https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_API_TOKEN=your_airtable_personal_access_token_here
AIRTABLE_BASE_ID=your_base_id_here
AIRTABLE_TABLE_NAME=Wisetribes

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
